# Copy to .env and add your keys. Never put real keys in this example.

# --- LLM (Gemini) ----------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=

# Policy search automatically uses gemini-embedding-001 with the same key.
# No embedding configuration or separate key is needed.

# --- Real-time voice (LiveKit) --------------------------------------------
# LiveKit server URL. With LiveKit Cloud this is wss://<project>.livekit.cloud;
# self-hosting defaults to ws://localhost:7880.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Internal address the agent worker uses to reach the LiveKit server (only
# needed when self-hosting behind docker). Falls back to LIVEKIT_URL.
# LIVEKIT_INTERNAL_URL=

# Speech-to-text + text-to-speech provider (Deepgram has a free tier).
DEEPGRAM_API_KEY=

# The backend is hosted-only: it fails fast at startup without a key (there is
# no demo or offline fallback).
